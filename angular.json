{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "cache": {
      "enabled": true,
      "environment": "all",
      "path": ".angular/cache"
    },
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui": {
      "projectType": "library",
      "root": "packages/ui",
      "sourceRoot": "packages/ui",
      "prefix": "haven",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "packages/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production",
          "options": {
            "project": "packages/ui/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.ui-spec.json",
            "include": ["**/*.spec.ts"]
          }
        }
      }
    },
    "browser-tests": {
      "projectType": "application",
      "root": "tools/browser/fixture",
      "sourceRoot": "tools/browser/fixture",
      "prefix": "haven",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tools/browser/fixture/main.ts",
            "index": "tools/browser/fixture/index.html",
            "tsConfig": "tools/browser/fixture/tsconfig.json",
            "styles": ["tools/browser/fixture/styles.scss"],
            "outputPath": "dist/browser-tests",
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
