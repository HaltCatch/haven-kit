{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/ui",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "form/**/*.ts",
    "page/**/*.ts",
    "theme/**/*.ts",
    "renderer/**/*.ts",
    "glass/**/*.ts",
    "table/**/*.ts",
