{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "expected": {
      "type": "object",
      "properties": {
        "documentId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "editRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["documentId", "sessionId", "editRevision"],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": { "const": "node.insert" },
              "parentId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "beforeId": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
                  { "type": "null" }
                ]
              },
              "node": { "$ref": "#/$defs/node" },
              "defaults": {
                "type": "object",
                "properties": {
                  "schema": { "$ref": "#/$defs/data" },
                  "resources": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "adapter": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
                        },
                        "type": { "enum": ["query", "options", "upload", "validation", "tree"] }
                      },
                      "required": ["adapter", "type"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": ["type", "parentId", "beforeId", "node"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "node.move" },
              "nodeId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "parentId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "beforeId": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["type", "nodeId", "parentId", "beforeId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "node.remove" },
              "nodeId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" }
            },
            "required": ["type", "nodeId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "node.patch" },
              "nodeId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "patch": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": { "enum": ["add", "replace", "test"] },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        },
                        "value": { "$ref": "#/$defs/json" }
                      },
                      "required": ["op", "path", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": { "const": "remove" },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        }
                      },
                      "required": ["op", "path"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": { "enum": ["copy", "move"] },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        },
                        "from": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        }
                      },
                      "required": ["op", "path", "from"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["type", "nodeId", "patch"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "document.patch" },
              "patch": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": { "enum": ["add", "replace", "test"] },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        },
                        "value": { "$ref": "#/$defs/json" }
                      },
                      "required": ["op", "path", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": { "const": "remove" },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        }
                      },
                      "required": ["op", "path"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": { "enum": ["copy", "move"] },
                        "path": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        },
                        "from": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                        }
                      },
                      "required": ["op", "path", "from"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["type", "patch"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["protocolVersion", "operationId", "expected", "commands"],
  "$defs": {
    "json": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "literal": { "$ref": "#/$defs/json" } },
          "required": ["literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
            "scope": { "enum": ["root", "item", "event"] }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains"] },
            "left": { "$ref": "#/$defs/value" },
            "right": { "$ref": "#/$defs/value" }
          },
          "required": ["op", "left", "right"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "op": { "const": "exists" }, "value": { "$ref": "#/$defs/value" } },
          "required": ["op", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": { "enum": ["and", "or"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          },
          "required": ["op", "conditions"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "op": { "const": "not" }, "condition": { "$ref": "#/$defs/condition" } },
          "required": ["op", "condition"],
          "additionalProperties": false
        }
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "type": { "enum": ["string", "number", "boolean", "object", "array", "null"] },
        "$ref": { "type": "string", "pattern": "^#/\\$defs/[a-zA-Z][a-zA-Z0-9_.-]*$" },
        "$defs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/data" } },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/data" } },
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "items": { "$ref": "#/$defs/data" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": ["string", "number", "boolean", "null"] }
        },
        "format": { "enum": ["email", "date", "time", "date-time"] },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["type"], "not": { "required": ["$ref"] } },
        { "required": ["$ref"], "not": { "required": ["type"] } }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
        "kind": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
        "version": { "type": "integer", "minimum": 1 },
        "props": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } },
        "bind": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "rules": {
          "type": "object",
          "properties": {
            "visible": { "$ref": "#/$defs/condition" },
            "disabled": { "$ref": "#/$defs/condition" },
            "required": { "$ref": "#/$defs/condition" }
          },
          "required": [],
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" }
          }
        },
        "validators": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
                  "message": {
                    "anyOf": [
                      { "type": "string", "maxLength": 4096 },
                      {
                        "type": "object",
                        "properties": {
                          "default": { "type": "string", "maxLength": 4096 },
                          "translations": {
                            "type": "object",
                            "maxProperties": 64,
                            "additionalProperties": { "type": "string", "maxLength": 4096 }
                          }
                        },
                        "required": ["default"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "type": { "const": "compare" },
                  "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
                  "other": { "$ref": "#/$defs/validationRef" }
                },
                "required": ["id", "message", "type", "operator", "other"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
                  "message": {
                    "anyOf": [
                      { "type": "string", "maxLength": 4096 },
                      {
                        "type": "object",
                        "properties": {
                          "default": { "type": "string", "maxLength": 4096 },
                          "translations": {
                            "type": "object",
                            "maxProperties": 64,
                            "additionalProperties": { "type": "string", "maxLength": 4096 }
                          }
                        },
                        "required": ["default"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "type": { "const": "async" },
                  "resource": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
                  "dependencies": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
                    },
                    "additionalProperties": { "$ref": "#/$defs/validationRef" }
                  },
                  "debounceMs": { "type": "integer", "minimum": 0, "maximum": 2000 }
                },
                "required": ["id", "message", "type", "resource"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["id", "kind", "version"],
      "additionalProperties": false
    },
    "validationRef": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "maxLength": 1024, "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "scope": { "enum": ["root", "item"] }
      },
      "required": ["path", "scope"],
      "additionalProperties": false
    }
  }
}
